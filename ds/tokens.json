{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "shieldai-design-system",
  "version": "1.0.0",
  "color": {
    "surface": {
      "bg":        { "$value": "#050101", "$description": "Page canvas / root" },
      "panel":     { "$value": "#0b0b11", "$description": "Cards, dialogs, popovers" },
      "current":   { "$value": "#1a1b26", "$description": "Borders, hover, dividers" },
      "selection": { "$value": "#282a36", "$description": "Selection, raised, tooltip" }
    },
    "text": {
      "fg":      { "$value": "#f8f8f2", "$description": "Primary text" },
      "comment": { "$value": "#6272a4", "$description": "Muted / captions" }
    },
    "signal": {
      "purple": { "$value": "#bd93f9", "$description": "primary · brand · LLM · A2A" },
      "green":  { "$value": "#50fa7b", "$description": "success · live · user · accent" },
      "cyan":   { "$value": "#8be9fd", "$description": "info · workflow · link" },
      "pink":   { "$value": "#ff79c6", "$description": "hover · parallel" },
      "orange": { "$value": "#ffb86c", "$description": "warning · loop · tool" },
      "yellow": { "$value": "#f1fa8c", "$description": "attention · sequential" },
      "red":    { "$value": "#ff5555", "$description": "destructive · task · alert" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "system-ui, Avenir, Helvetica, Arial, sans-serif" },
      "mono": { "$value": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "size": {
      "9":  { "$value": "9px" },
      "10": { "$value": "10px" },
      "12": { "$value": "12px" },
      "14": { "$value": "14px" },
      "16": { "$value": "16px" },
      "20": { "$value": "20px" },
      "24": { "$value": "24px" },
      "32": { "$value": "32px" },
      "40": { "$value": "40px" },
      "56": { "$value": "56px" },
      "72": { "$value": "72px" }
    },
    "tracking": {
      "widest": { "$value": "0.2em", "$description": "Signature label spacing" }
    }
  },
  "spacing": {
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" }
  },
  "radius": {
    "none": { "$value": "0" },
    "sm":   { "$value": "2px" },
    "md":   { "$value": "4px" },
    "lg":   { "$value": "8px" },
    "xl":   { "$value": "12px" },
    "2xl":  { "$value": "16px" },
    "pill": { "$value": "9999px" }
  },
  "shadow": {
    "glow": {
      "sm-purple": { "$value": "0 0 8px rgba(189,147,249,0.30)" },
      "md-purple": { "$value": "0 0 15px rgba(189,147,249,0.35)" },
      "lg-purple": { "$value": "0 0 25px rgba(189,147,249,0.55)" },
      "xl-purple": { "$value": "0 0 40px rgba(189,147,249,0.70), inset 0 0 20px rgba(189,147,249,0.2)" },
      "md-green":  { "$value": "0 0 15px rgba(80,250,123,0.35)" },
      "md-cyan":   { "$value": "0 0 15px rgba(139,233,253,0.35)" },
      "md-pink":   { "$value": "0 0 15px rgba(255,121,198,0.35)" },
      "md-orange": { "$value": "0 0 15px rgba(255,184,108,0.35)" },
      "md-yellow": { "$value": "0 0 15px rgba(241,250,140,0.35)" },
      "md-red":    { "$value": "0 0 15px rgba(255,85,85,0.35)" }
    },
    "neu": {
      "sm":     { "$value": "2px 2px 0px 0px rgba(0,0,0,1)" },
      "md":     { "$value": "4px 4px 0px 0px rgba(0,0,0,1)" },
      "lg":     { "$value": "6px 6px 0px 0px rgba(0,0,0,1)" },
      "purple": { "$value": "4px 4px 0px 0px #bd93f9" },
      "green":  { "$value": "4px 4px 0px 0px #50fa7b" },
      "pink":   { "$value": "4px 4px 0px 0px #ff79c6" },
      "cyan":   { "$value": "4px 4px 0px 0px #8be9fd" },
      "orange": { "$value": "4px 4px 0px 0px #ffb86c" },
      "red":    { "$value": "4px 4px 0px 0px #ff5555" }
    }
  },
  "motion": {
    "duration": {
      "fast":    { "$value": "150ms" },
      "default": { "$value": "200ms" },
      "slow":    { "$value": "300ms" }
    },
    "easing": {
      "out":    { "$value": "cubic-bezier(0.4,0,0.2,1)" },
      "spring": { "$value": "cubic-bezier(0.34,1.56,0.64,1)" }
    }
  },
  "z": {
    "base":     { "$value": 1 },
    "dropdown": { "$value": 50 },
    "sticky":   { "$value": 60 },
    "overlay":  { "$value": 70 },
    "modal":    { "$value": 80 },
    "toast":    { "$value": 90 },
    "tooltip":  { "$value": 100 }
  },
  "breakpoints": {
    "sm":  { "$value": "640px" },
    "md":  { "$value": "768px" },
    "lg":  { "$value": "1024px" },
    "xl":  { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  },
  "agent_types": {
    "llm":        { "color": "{color.signal.green}",  "icon": "code" },
    "a2a":        { "color": "{color.signal.purple}", "icon": "external-link" },
    "sequential": { "color": "{color.signal.yellow}", "icon": "arrow-right" },
    "parallel":   { "color": "{color.signal.pink}",   "icon": "git-branch" },
    "loop":       { "color": "{color.signal.orange}", "icon": "refresh-cw" },
    "workflow":   { "color": "{color.signal.cyan}",   "icon": "workflow" },
    "task":       { "color": "{color.signal.red}",    "icon": "book-open-check" }
  }
}
